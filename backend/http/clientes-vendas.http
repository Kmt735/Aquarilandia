@api=http://localhost:3333/api
@origem=http://localhost:5173
@sessaoAdmin=SUBSTITUA_PELO_TOKEN_DA_SESSAO_ADMIN
@sessaoCliente=SUBSTITUA_PELO_TOKEN_DA_SESSAO_CLIENTE

# Dados e credenciais abaixo são inteiramente fictícios; use somente um banco de testes.
# Execute cada grupo separadamente: tentativas anteriores contam nos rate limits reais.


# 401 sem sessão; confirme que o cliente HTTP não envia cookies salvos automaticamente.
GET {{api}}/orcamentos
Cookie:

###
# 403 para cliente autenticado, sem revelar orçamentos.
GET {{api}}/orcamentos
Cookie: sid={{sessaoCliente}}

###
# Prepare o admin com npm run criar-admin e faça login; preencha @sessaoAdmin com o sid emitido.
# 200 somente com sessão administrativa válida; cliente autenticado recebe 403.
GET {{api}}/orcamentos
Cookie: sid={{sessaoAdmin}}


###
post {{api}}/orcamentos
Content-Type: application/json
Origin: {{origem}}

{
    "nome": "Cliente Teste",
    "telefone": "0090000000",
    "servico": "Manutenção",
    "mensagem": "Quero montar um aquario de 100 litros"
}

# ===== ORÇAMENTOS NO BANCO (POST, GET paginado e PATCH de status) =====
# RATE LIMIT: o POST aceita 5 pedidos por hora por IP, CONTANDO os que deram certo (o 6º → 429).
# Rode os blocos de POST com moderação ou reinicie o servidor para zerar o contador.
# Limpeza: DELETE FROM orcamentos WHERE id IN (<ids dos testes>);

# 201 - pedido válido: o telefone é salvo só com dígitos e o status nasce 'novo'
###
POST {{api}}/orcamentos
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Pessoa Exemplo",
  "telefone": "(00) 90000-0000",
  "servico": "Manutenção",
  "mensagem": "Aquário de 60 litros"
}

# 201 - campos do sistema são ignorados: id e status do body não valem (status fica 'novo')
###
POST {{api}}/orcamentos
Content-Type: application/json
Origin: {{origem}}

{
  "id": 999,
  "status": "concluido",
  "nome": "Pessoa Exemplo",
  "telefone": "00900000000",
  "servico": "Outro"
}

# 422 - nome curto, telefone incompleto e serviço fora da lista (as mesmas mensagens de antes)
###
POST {{api}}/orcamentos
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "A",
  "telefone": "123",
  "servico": "Serviço inventado"
}

# 401 - listagem sem login
###
# @no-cookie-jar
GET {{api}}/orcamentos

# 403 - listagem como cliente
###
GET {{api}}/orcamentos
Cookie: sid={{sessaoCliente}}

# 200 - admin: { dados, total, pagina, limite }, os mais recentes primeiro
###
GET {{api}}/orcamentos?pagina=1&limite=20
Cookie: sid={{sessaoAdmin}}

# 200 - só os novos
###
GET {{api}}/orcamentos?status=novo
Cookie: sid={{sessaoAdmin}}

# 400 - status que não existe (detalhes.status)
###
GET {{api}}/orcamentos?status=xyz
Cookie: sid={{sessaoAdmin}}

# 400 - limite acima de 100 (detalhes.limite)
###
GET {{api}}/orcamentos?limite=500
Cookie: sid={{sessaoAdmin}}

@orcamentoId=SUBSTITUA_PELO_ID_DE_UM_ORCAMENTO

# 200 - admin marca como em atendimento (só o status muda; nome e telefone do body são ignorados)
###
PATCH {{api}}/orcamentos/{{orcamentoId}}
Content-Type: application/json
Origin: {{origem}}
Cookie: sid={{sessaoAdmin}}

{ "status": "em_atendimento", "nome": "Outro nome" }

# 422 - status inválido (também sem trim: " novo " é recusado)
###
PATCH {{api}}/orcamentos/{{orcamentoId}}
Content-Type: application/json
Origin: {{origem}}
Cookie: sid={{sessaoAdmin}}

{ "status": "aprovado" }

# 400 - id que não é número
###
PATCH {{api}}/orcamentos/abc
Content-Type: application/json
Origin: {{origem}}
Cookie: sid={{sessaoAdmin}}

{ "status": "concluido" }

# 404 - id que não existe ('Orçamento não encontrado.')
###
PATCH {{api}}/orcamentos/999999
Content-Type: application/json
Origin: {{origem}}
Cookie: sid={{sessaoAdmin}}

{ "status": "concluido" }

# 403 - cliente não muda status
###
PATCH {{api}}/orcamentos/{{orcamentoId}}
Content-Type: application/json
Origin: {{origem}}
Cookie: sid={{sessaoCliente}}

{ "status": "concluido" }

# 403 - admin sem Origin
###
PATCH {{api}}/orcamentos/{{orcamentoId}}
Content-Type: application/json
Cookie: sid={{sessaoAdmin}}

{ "status": "concluido" }


###
get {{api}}/rota-que-nao-existe


###
post {{api}}/orcamentos
Content-Type: application/json
Origin: {{origem}}

{ /

###
post {{api}}/auth/cadastro
Content-type: application/json
Origin: {{origem}}

{
    "nome": "Cliente Fictício",
    "email": "cliente.teste@example.com",
    "senha": "SenhaFicticiaPrincipal123!",
    "telefone": "00900000000",
    "aceiteTermos": true
}

# 409 - e-mail repetido (com detalhes.email)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Cliente Fictício",
  "email": "cliente.teste@example.com",
  "senha": "SenhaFicticiaPrincipal123!",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 409 - mesmo e-mail com maiúsculas (prova o toLowerCase)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Cliente Fictício",
  "email": "  CLIENTE.TESTE@EXAMPLE.COM  ",
  "senha": "SenhaFicticiaPrincipal123!",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 422 - body vazio (erro nos 5 campos)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{}

# 422 - senha curta (só o campo senha)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Teste Senha",
  "email": "senha.curta@example.com",
  "senha": "1234567",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 201 - telefone com máscara (no banco deve ficar só dígitos)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Teste Mascara",
  "email": "mascara@example.com",
  "senha": "senha1234",
  "telefone": "(00) 90000-0000",
  "aceiteTermos": true
}

# 422 - aceiteTermos como string (só o campo aceiteTermos)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Teste Termos",
  "email": "termos@example.com",
  "senha": "senha1234",
  "telefone": "00900000000",
  "aceiteTermos": "true"
}

# 400 - body null (o express.json em modo strict recusa raiz null: JSON malformado, api.md seção 5)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

null

# ===== LOGIN =====

# 200 - login certo (confira o Set-Cookie nos headers da resposta)
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "cliente.teste@example.com",
  "senha": "SenhaFicticiaPrincipal123!"
}

# 401 - senha errada
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "cliente.teste@example.com",
  "senha": "senhaerrada123"
}

# 401 - e-mail que não existe (mesma mensagem da senha errada)
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "naoexiste@example.com",
  "senha": "SenhaFicticiaPrincipal123!"
}

# 200 - e-mail com maiúsculas e espaços (prova a normalização)
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "  CLIENTE.TESTE@EXAMPLE.COM  ",
  "senha": "SenhaFicticiaPrincipal123!"
}

# 422 - body vazio (erro em email e senha)
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{}

# 401 - conta inativa
# Antes: no Adminer, mude o "ativo" da cliente.teste@example.com para false.
# Depois do teste, volte para true.
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "cliente.teste@example.com",
  "senha": "SenhaFicticiaPrincipal123!"
}

# ===== RATE LIMIT =====
# Login: rode este bloco 6 vezes seguidas (senha errada).
# Esperado: 401 nas 5 primeiras e 429 na 6ª, com {"erro":"Muitas tentativas..."}.
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "cliente.teste@example.com",
  "senha": "senhaerrada123"
}

# ===== CONTA (/me) =====
# Preparação: cadastre as duas contas de teste e faça login com a Ana (o cookie "sid" fica no cookie jar).
# No fim, apague as contas: DELETE FROM clientes WHERE email LIKE 'teste.conta.%@example.com';

# 201 - conta de teste A
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Ana Conta",
  "email": "teste.conta.ana@example.com",
  "senha": "senhaAna1234",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 201 - conta de teste B (dona do e-mail usado no teste de conflito)
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Bruno Conta",
  "email": "teste.conta.bruno@example.com",
  "senha": "senhaBruno1234",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 200 - login da Ana
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.ana@example.com",
  "senha": "senhaAna1234"
}

# 401 - GET /me sem login
###
# @no-cookie-jar
GET {{api}}/clientes/me

# 401 - GET /me com cookie inventado
###
# @no-cookie-jar
GET {{api}}/clientes/me
Cookie: sid=tokeninventado123

# 200 - GET /me logado (sem senhaHash na resposta)
###
GET {{api}}/clientes/me

# 401 - PATCH /me sem login
###
# @no-cookie-jar
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "nome": "Sem Login" }

# 200 - só o telefone (salvo como 32988887777; nome e e-mail não mudam)
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "telefone": "(00) 90000-0000" }

# 200 - campos do sistema são ignorados: papel, ativo e id não mudam; só o nome muda
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{
  "papel": "admin",
  "ativo": false,
  "id": 999,
  "nome": "Novo Nome"
}

# 422 - nenhum campo (detalhes.body)
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{}

# 422 - e-mail e telefone inválidos (os dois erros juntos)
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{
  "email": "nada",
  "telefone": "123"
}

# 409 - e-mail de outra conta (detalhes.email). Desde a D-47 a senha atual vem antes: sem ela seria 422
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.bruno@example.com",
  "senhaAtual": "senhaAna1234"
}

# 200 - o próprio e-mail em maiúsculas não é conflito nem troca: não pede senhaAtual (fica salvo em minúsculas)
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "email": "TESTE.CONTA.ANA@EXAMPLE.COM" }

# ----- D-47: trocar o e-mail exige a senha atual -----
# As tentativas com email no body contam no mesmo limite da troca de senha (5 erros em 15 min).

# 422 - e-mail novo sem senhaAtual (detalhes.senhaAtual: 'Digite sua senha atual para trocar o e-mail.')
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "email": "teste.conta.ana2@example.com" }

# 422 - senha atual errada (detalhes.senhaAtual: 'Senha atual incorreta.')
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.ana2@example.com",
  "senhaAtual": "senhaErrada999"
}

# 200 - com a senha certa: o e-mail muda, os links de recuperação pendentes morrem e o aviso
# "Aquarilândia: seu e-mail foi alterado" vai para o e-mail ANTIGO (em dev sem chave: "[email:dev]" no terminal)
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.ana2@example.com",
  "senhaAtual": "senhaAna1234"
}

# 200 - volta para o e-mail original (para os blocos seguintes continuarem valendo)
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.ana@example.com",
  "senhaAtual": "senhaAna1234"
}

# 400 - body null: o express.json (modo strict, no app.ts) recusa raiz que não é objeto nem array
# antes de chegar ao service. Com [] ou sem body, quem responde é o service: 422 detalhes.body.
###
PATCH {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

null

# ===== CONTA — TROCA DE SENHA (/me/senha) =====
# Para ver as outras sessões caindo: faça login da Ana também em outro cliente HTTP (ou navegador),
# troque a senha aqui e confira o GET /auth/sessao nos dois: aqui 200, no outro 401.

# 401 - troca sem login
###
# @no-cookie-jar
PATCH {{api}}/clientes/me/senha
Content-Type: application/json
Origin: {{origem}}

{
  "senhaAtual": "senhaAna1234",
  "novaSenha": "novaSenhaAna1234"
}

# 422 - senha atual errada (detalhes.senhaAtual)
###
PATCH {{api}}/clientes/me/senha
Content-Type: application/json
Origin: {{origem}}

{
  "senhaAtual": "senhaErrada999",
  "novaSenha": "novaSenhaAna1234"
}

# 422 - nova senha curta (detalhes.novaSenha)
###
PATCH {{api}}/clientes/me/senha
Content-Type: application/json
Origin: {{origem}}

{
  "senhaAtual": "senhaAna1234",
  "novaSenha": "123"
}

# 422 - nova senha igual à atual (detalhes.novaSenha)
###
PATCH {{api}}/clientes/me/senha
Content-Type: application/json
Origin: {{origem}}

{
  "senhaAtual": "senhaAna1234",
  "novaSenha": "senhaAna1234"
}

# 204 - troca certa (as outras sessões da Ana são apagadas; esta continua)
###
PATCH {{api}}/clientes/me/senha
Content-Type: application/json
Origin: {{origem}}

{
  "senhaAtual": "senhaAna1234",
  "novaSenha": "novaSenhaAna1234"
}

# 200 - a sessão de quem trocou continua valendo
###
GET {{api}}/auth/sessao

# 401 - login com a senha antiga
###
# @no-cookie-jar
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.ana@example.com",
  "senha": "senhaAna1234"
}

# 200 - login com a senha nova
###
# @no-cookie-jar
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.conta.ana@example.com",
  "senha": "novaSenhaAna1234"
}

# Rate limit da troca: rode este bloco 6 vezes seguidas (senha atual errada).
# Esperado: 422 nas 5 primeiras e 429 na 6ª, com {"erro":"Muitas tentativas..."}.
# Os 422 dos blocos acima também contam (janela de 15 minutos): reinicie o servidor antes.
###
PATCH {{api}}/clientes/me/senha
Content-Type: application/json
Origin: {{origem}}

{
  "senhaAtual": "senhaErrada999",
  "novaSenha": "outraSenha1234"
}

# ===== RECUPERAÇÃO DE SENHA (esqueci-senha e redefinir-senha) =====
# O servidor precisa de FRONTEND_URL (ex.: http://localhost:5173); sem ela, nenhum link é criado.
# Em desenvolvimento sem EMAIL_API_KEY, o e-mail aparece no terminal do servidor como "[email:dev]",
# com o link .../redefinir-senha?token=<token>. Copie o token de lá para @tokenRecuperacao (não commite).
# RATE LIMIT: esqueci-senha aceita 3 pedidos por hora por IP e 3 por hora por e-mail, CONTANDO os que deram
# certo; redefinir-senha, 10 por hora por IP. Reinicie o servidor para zerar os contadores.
@tokenRecuperacao=COLE_AQUI_O_TOKEN_DO_TERMINAL

# 202 - conta existente: a resposta é sempre a mesma
###
POST {{api}}/auth/esqueci-senha
Content-Type: application/json
Origin: {{origem}}

{ "email": "teste.conta.ana@example.com" }

# 202 - conta que não existe: o MESMO corpo, sem e-mail no terminal
###
POST {{api}}/auth/esqueci-senha
Content-Type: application/json
Origin: {{origem}}

{ "email": "ninguem.teste@example.com" }

# 422 - e-mail mal formado (detalhes.email)
###
POST {{api}}/auth/esqueci-senha
Content-Type: application/json
Origin: {{origem}}

{ "email": "nada" }

# 400 - token inventado: 'Link inválido ou expirado.' (a mesma mensagem para vencido, já usado ou conta desativada)
###
POST {{api}}/auth/redefinir-senha
Content-Type: application/json
Origin: {{origem}}

{
  "token": "tokeninventado",
  "novaSenha": "senhaRedefinida1234"
}

# 422 - nova senha curta (detalhes.novaSenha)
###
POST {{api}}/auth/redefinir-senha
Content-Type: application/json
Origin: {{origem}}

{
  "token": "{{tokenRecuperacao}}",
  "novaSenha": "123"
}

# 204 - redefine com o token do terminal: todas as sessões da conta caem e o link não vale de novo (repita: 400)
###
POST {{api}}/auth/redefinir-senha
Content-Type: application/json
Origin: {{origem}}

{
  "token": "{{tokenRecuperacao}}",
  "novaSenha": "senhaRedefinida1234"
}

# ===== ENDEREÇOS (/me/enderecos) =====
# Preparação: cadastre a Ana e a Bia e faça login com a Ana (o cookie "sid" fica no cookie jar).
# Para os testes de IDOR, faça login com a Bia e use o id de um endereço da Ana.
# No fim, apague as contas (os endereços e as sessões saem por CASCADE):
# DELETE FROM clientes WHERE email LIKE 'teste.end.%@exemplo.com';

@enderecoId=SUBSTITUA_PELO_ID_DE_UM_ENDERECO

# 201 - conta de teste Ana
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Ana Endereco",
  "email": "teste.end.ana@exemplo.com",
  "senha": "senhaAna1234",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 201 - conta de teste Bia
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Bia Endereco",
  "email": "teste.end.bia@exemplo.com",
  "senha": "senhaBia1234",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 200 - login da Ana
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.end.ana@exemplo.com",
  "senha": "senhaAna1234"
}

# 401 - listar sem login
###
# @no-cookie-jar
GET {{api}}/clientes/me/enderecos

# 401 - criar sem login
###
# @no-cookie-jar
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{ "cep": "36300000", "logradouro": "Rua Sem Login", "numero": "1", "bairro": "Centro", "cidade": "Cidade", "uf": "MG" }

# 403 - criar sem Origin (nada é criado)
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json

{ "cep": "36300000", "logradouro": "Rua Sem Origem", "numero": "1", "bairro": "Centro", "cidade": "Cidade", "uf": "MG" }

# 422 - body vazio (cep, logradouro, numero, bairro, cidade e uf)
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{}

# 201 - primeiro endereço: vira principal mesmo sem pedir; cep salvo como 36300000 e uf como MG
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{
  "apelido": "Casa",
  "cep": "36300-000",
  "logradouro": "Rua das Flores",
  "numero": "10",
  "complemento": "",
  "bairro": "Centro",
  "cidade": "São João del-Rei",
  "uf": " mg "
}

# 201 - campos do sistema são ignorados: clienteId e id do body não valem
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{
  "id": 999,
  "clienteId": 999,
  "criadoEm": "2000-01-01T00:00:00.000Z",
  "cep": "36300000",
  "logradouro": "Rua do Trabalho",
  "numero": "200",
  "bairro": "Fábricas",
  "cidade": "São João del-Rei",
  "uf": "MG"
}

# 201 - marcado como principal: o anterior deixa de ser
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{
  "apelido": "Sítio",
  "cep": "36300000",
  "logradouro": "Estrada Real",
  "numero": "S/N",
  "bairro": "Zona Rural",
  "cidade": "Tiradentes",
  "uf": "MG",
  "principal": true
}

# 422 - cep curto e uf inexistente (detalhes.cep e detalhes.uf)
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{ "cep": "3630", "logradouro": "Rua A", "numero": "1", "bairro": "Centro", "cidade": "Cidade", "uf": "XX" }

# 422 - principal como texto (sem Boolean(): "sim", 1 e "true" são recusados)
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{ "cep": "36300000", "logradouro": "Rua A", "numero": "1", "bairro": "Centro", "cidade": "Cidade", "uf": "MG", "principal": "sim" }

# 400 - body null (express.json strict); com [] quem responde é o service: 422 detalhes.body
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

null

# 409 - 11º endereço (rode depois de ter 10): 'Você já tem 10 endereços cadastrados.'
###
POST {{api}}/clientes/me/enderecos
Content-Type: application/json
Origin: {{origem}}

{ "cep": "36300000", "logradouro": "Rua Onze", "numero": "11", "bairro": "Centro", "cidade": "Cidade", "uf": "MG" }

# 200 - lista da Ana: principal primeiro, depois do mais novo para o mais antigo
###
GET {{api}}/clientes/me/enderecos

# 200 - só o número muda
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json
Origin: {{origem}}

{ "numero": "25A" }

# 200 - vira o único principal
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json
Origin: {{origem}}

{ "principal": true }

# 422 - desmarcar o principal (detalhes.principal); para trocar, marque outro como principal
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json
Origin: {{origem}}

{ "principal": false }

# 422 - nenhum campo (detalhes.body)
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json
Origin: {{origem}}

{}

# 422 - só o cep inválido (detalhes.cep)
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json
Origin: {{origem}}

{ "cep": "1" }

# 400 - id que não é número inteiro positivo ('abc' ou 0)
###
PATCH {{api}}/clientes/me/enderecos/abc
Content-Type: application/json
Origin: {{origem}}

{ "numero": "1" }

# 404 - id que não existe
###
PATCH {{api}}/clientes/me/enderecos/999999
Content-Type: application/json
Origin: {{origem}}

{ "numero": "1" }

# 403 - PATCH sem Origin
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json

{ "numero": "1" }

# 204 - apagar um endereço (se era o principal, o mais recente que sobrou assume)
###
DELETE {{api}}/clientes/me/enderecos/{{enderecoId}}
Origin: {{origem}}

# 404 - apagar de novo o mesmo id
###
DELETE {{api}}/clientes/me/enderecos/{{enderecoId}}
Origin: {{origem}}

# 403 - DELETE sem Origin
###
DELETE {{api}}/clientes/me/enderecos/{{enderecoId}}

# IDOR: faça login com a Bia e use em @enderecoId o id de um endereço da Ana.
# 200 - login da Bia
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.end.bia@exemplo.com",
  "senha": "senhaBia1234"
}

# 404 - Bia tenta alterar o endereço da Ana ('Endereço não encontrado.'; nada muda)
###
PATCH {{api}}/clientes/me/enderecos/{{enderecoId}}
Content-Type: application/json
Origin: {{origem}}

{ "numero": "666" }

# 404 - Bia tenta apagar o endereço da Ana (ele continua lá)
###
DELETE {{api}}/clientes/me/enderecos/{{enderecoId}}
Origin: {{origem}}

# ===== APAGAR CONTA (DELETE /me) =====
# ATENÇÃO: depois de apagada, a conta é anonimizada (e-mail vira NULL) e NÃO é mais achada pelo e-mail.
# Anote o id logo depois do cadastro: SELECT id FROM clientes WHERE email = 'teste.lgpd.ana@exemplo.com';
# Para limpar, use o id (as vendas de teste primeiro, porque vendas → clientes não tem CASCADE):
# DELETE FROM vendas WHERE cliente_id = <id>; DELETE FROM clientes WHERE id = <id>;
# Os 422/403/409 contam no mesmo limite da troca de senha (5 em 15 min): reinicie o servidor se der 429.

# 201 - conta de teste
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Ana LGPD",
  "email": "teste.lgpd.ana@exemplo.com",
  "senha": "senhaAna1234",
  "telefone": "00900000000",
  "aceiteTermos": true
}

# 200 - login
###
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.lgpd.ana@exemplo.com",
  "senha": "senhaAna1234"
}

# 401 - sem login
###
# @no-cookie-jar
DELETE {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "senha": "senhaAna1234" }

# 403 - sem Origin (a conta continua ativa)
###
DELETE {{api}}/clientes/me
Content-Type: application/json

{ "senha": "senhaAna1234" }

# 422 - sem senha (detalhes.senha: 'Digite sua senha para confirmar.')
###
DELETE {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{}

# 422 - senha errada (detalhes.senha: 'Senha incorreta.')
###
DELETE {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "senha": "senhaErrada999" }

# 403 - conta de admin (faça login com um admin antes): 'Contas de administrador não podem ser apagadas por aqui.'
# 409 - com venda em andamento: 'Você tem compras em andamento. Aguarde a entrega ou cancele antes de apagar a conta.'
# 204 - senha certa: o cookie "sid" é limpo, as sessões, os endereços e os tokens somem e a conta é anonimizada
###
DELETE {{api}}/clientes/me
Content-Type: application/json
Origin: {{origem}}

{ "senha": "senhaAna1234" }

# 401 - a sessão caiu junto com a conta
###
GET {{api}}/clientes/me

# 401 - login com o e-mail e a senha antigos (mesma mensagem de senha errada)
###
# @no-cookie-jar
POST {{api}}/auth/login
Content-Type: application/json
Origin: {{origem}}

{
  "email": "teste.lgpd.ana@exemplo.com",
  "senha": "senhaAna1234"
}

# 201 - o e-mail ficou livre: o cadastro cria uma conta nova, com outro id
###
POST {{api}}/auth/cadastro
Content-Type: application/json
Origin: {{origem}}

{
  "nome": "Ana LGPD",
  "email": "teste.lgpd.ana@exemplo.com",
  "senha": "senhaAna1234",
  "telefone": "00900000000",
  "aceiteTermos": true
}


# ===== ADMIN DE CLIENTES (/api/clientes) =====
# Só admin: GET /, GET /:id, PATCH /:id { ativo } e DELETE /:id. As /me continuam do cliente (registradas antes da guarda).
# Contas de teste: cadastre teste.adm.chefe@exemplo.com e promova por SQL, depois faça login de novo:
#   UPDATE clientes SET papel = 'admin' WHERE email = 'teste.adm.chefe@exemplo.com';
# Anote os ids (SELECT id, email FROM clientes WHERE email LIKE 'teste.adm.%') e preencha as variáveis abaixo.
# Para limpar, pelos ids: DELETE FROM historico_status_venda WHERE venda_id IN (...); DELETE FROM vendas WHERE cliente_id IN (...);
# DELETE FROM clientes WHERE id IN (...);
@idClienteAdm=SUBSTITUA_PELO_ID_DO_CLIENTE
@idOutroAdmin=SUBSTITUA_PELO_ID_DE_OUTRO_ADMIN

# 401 - sem login
###
# @no-cookie-jar
GET {{api}}/clientes

# 403 - cliente logado (também em /clientes/xyz: a guarda vem antes do id, não é 404)
###
# @no-cookie-jar
GET {{api}}/clientes/xyz
Cookie: sid={{sessaoCliente}}

# 200 - lista paginada de clientes (sem admins e sem anonimizados), com quantidadeVendas; Cache-Control: no-store
###
GET {{api}}/clientes?pagina=1&limite=20
Cookie: sid={{sessaoAdmin}}

# 200 - busca por nome ou e-mail (sem diferenciar maiúsculas); % e _ são texto literal: 50% acha só quem tem "50%"
###
GET {{api}}/clientes?busca=50%25
Cookie: sid={{sessaoAdmin}}

# 200 - só os admins
###
GET {{api}}/clientes?papel=admin
Cookie: sid={{sessaoAdmin}}

# 400 - papel fora da lista: detalhes.papel 'Use cliente ou admin.'
###
GET {{api}}/clientes?papel=xyz
Cookie: sid={{sessaoAdmin}}

# 400 - limite acima de 100
###
GET {{api}}/clientes?limite=500
Cookie: sid={{sessaoAdmin}}

# 200 - detalhe: dados, enderecos, totalVendas (todas) e totalGasto (centavos, só pagas/em andamento/entregues)
###
GET {{api}}/clientes/{{idClienteAdm}}
Cookie: sid={{sessaoAdmin}}

# 400 - id inválido / 404 - inexistente
###
GET {{api}}/clientes/abc
Cookie: sid={{sessaoAdmin}}

###
GET {{api}}/clientes/999999
Cookie: sid={{sessaoAdmin}}

# 200 - desativar: as sessões e os links de recuperação do cliente caem na hora; repetir devolve 200 sem mudar nada
###
PATCH {{api}}/clientes/{{idClienteAdm}}
Cookie: sid={{sessaoAdmin}}
Content-Type: application/json
Origin: {{origem}}

{ "ativo": false }

# 200 - reativar (o login volta a funcionar; as sessões antigas não voltam)
###
PATCH {{api}}/clientes/{{idClienteAdm}}
Cookie: sid={{sessaoAdmin}}
Content-Type: application/json
Origin: {{origem}}

{ "ativo": true }

# 422 - ativo precisa ser exatamente true ou false ('false', 0, null e {} são recusados)
###
PATCH {{api}}/clientes/{{idClienteAdm}}
Cookie: sid={{sessaoAdmin}}
Content-Type: application/json
Origin: {{origem}}

{ "ativo": "false" }

# 409 - conta de administrador (outro admin ou o próprio): 'Não é possível alterar uma conta de administrador.'
###
PATCH {{api}}/clientes/{{idOutroAdmin}}
Cookie: sid={{sessaoAdmin}}
Content-Type: application/json
Origin: {{origem}}

{ "ativo": false }

# 403 - sem Origin
###
PATCH {{api}}/clientes/{{idClienteAdm}}
Cookie: sid={{sessaoAdmin}}
Content-Type: application/json

{ "ativo": false }

# 409 - com venda em andamento: 'Este cliente tem compras em andamento. Aguarde a entrega ou o cancelamento antes de remover a conta.'
# 204 - sem venda em andamento: a conta é anonimizada (vale também para cliente desativado)
# 404 - repetir (já anonimizado) / 409 - conta de admin
###
DELETE {{api}}/clientes/{{idClienteAdm}}
Cookie: sid={{sessaoAdmin}}
Origin: {{origem}}

# ===== FRETE E VENDAS =====
# Troque os ids pelos de produtos ativos do seu banco de dev (o cadastro cria tudo com estoque 0: dê entrada
# em POST /api/estoque/movimentacoes antes de comprar) e pelo id de um endereço do cliente logado.
@produtoA=1
@produtoB=2
@produtoPeixe=3
@enderecoId=SUBSTITUA_PELO_ID_DE_UM_ENDERECO_DO_CLIENTE

# 200 - cotação pública em São João del Rei: { frete, prazoDias, tipoEntrega: 'propria', subtotal, total }
###
# @no-cookie-jar
POST {{api}}/frete/calcular
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 2 }, { "produtoId": {{produtoB}}, "quantidade": 1 }], "cep": "36307-000" }

# 200 - outro estado (Correios) e retirada na loja (frete 0)
###
# @no-cookie-jar
POST {{api}}/frete/calcular
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }], "cep": "01001000" }

###
# @no-cookie-jar
POST {{api}}/frete/calcular
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }, { "produtoId": {{produtoPeixe}}, "quantidade": 1 }], "retirada": true }

# 422 - peixe fora de São João del Rei: 'itens.1.produtoId' (índice do item no body)
###
# @no-cookie-jar
POST {{api}}/frete/calcular
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }, { "produtoId": {{produtoPeixe}}, "quantidade": 1 }], "cep": "01001000" }

# 422 - sem cep e sem retirada: { entrega: 'Escolha um endereço de entrega ou retirar na loja.' }
###
# @no-cookie-jar
POST {{api}}/frete/calcular
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }] }

# 403 - sem Origin (429 depois de 30 cotações no mesmo minuto, por IP)
###
# @no-cookie-jar
POST {{api}}/frete/calcular
Content-Type: application/json

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }], "retirada": true }

# 201 - venda com entrega no endereço salvo. Preço, total, status e clienteId do body são ignorados
###
POST {{api}}/vendas
Cookie: sid={{sessaoCliente}}
Content-Type: application/json
Origin: {{origem}}

{
  "itens": [
    { "produtoId": {{produtoA}}, "quantidade": 2, "precoUnitario": 1 },
    { "produtoId": {{produtoA}}, "quantidade": 1 }
  ],
  "enderecoId": {{enderecoId}},
  "total": 1,
  "status": "paga"
}

# 201 - retirada na loja: tipoEntrega 'retirada', frete 0, entrega null
###
POST {{api}}/vendas
Cookie: sid={{sessaoCliente}}
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoB}}, "quantidade": 1 }], "retirada": true }

# 409 - estoque insuficiente: { 'itens.0.quantidade': 'Não temos essa quantidade em estoque.' }
# 409 - a 6ª compra aguardando pagamento: 'Você já tem 5 compras aguardando pagamento.'
###
POST {{api}}/vendas
Cookie: sid={{sessaoCliente}}
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoB}}, "quantidade": 50 }], "retirada": true }

# 422 - 31 itens, quantidade 51, ou o mesmo produto somando mais de 50 (aqui: 'itens.0.quantidade')
###
POST {{api}}/vendas
Cookie: sid={{sessaoCliente}}
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 30 }, { "produtoId": {{produtoA}}, "quantidade": 21 }], "retirada": true }

# 404 - endereço que não é do cliente logado: 'Endereço não encontrado.'
###
POST {{api}}/vendas
Cookie: sid={{sessaoCliente}}
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }], "enderecoId": 2147483000 }

# 401 - sem login
###
# @no-cookie-jar
POST {{api}}/vendas
Content-Type: application/json
Origin: {{origem}}

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }], "retirada": true }

# 403 - sem Origin
###
POST {{api}}/vendas
Cookie: sid={{sessaoCliente}}
Content-Type: application/json

{ "itens": [{ "produtoId": {{produtoA}}, "quantidade": 1 }], "retirada": true }
