# Modelo do backend/.env: copie (cp .env.example .env) e troque os placeholders. O .env nunca vai para o Git.
# O backend não sobe sem NODE_ENV e DATABASE_URL; em produção exige mais (D-52, docs/decisoes.md).
# Nenhum valor aqui é real: TROQUE_* é placeholder, e vazio quer dizer "desligado em desenvolvimento".

# --- Ambiente ---
# Obrigatória, sem padrão: development, test ou production
NODE_ENV=development
# Porta da API (padrão 3333 se ausente)
PORT=3333
# Origem do frontend aceita no CORS e no header Origin. Fora de produção o padrão é http://localhost:5173;
# em produção é obrigatória e começa com https://
CORS_ORIGIN=http://localhost:5173

# --- Banco (lidas pelo docker-compose.yml) ---
# Obrigatórias para o compose. Ficam gravadas no volume na primeira criação do banco:
# quem já tem o banco põe aqui os MESMOS valores de hoje (trocar aqui não troca a senha do banco)
DB_USER=aquarilandia
DB_PASSWORD=TROQUE_ESTA_SENHA
DB_NAME=aquarilandia
# Porta publicada só em 127.0.0.1 (padrão 5432)
DB_PORT=5432
# Obrigatória, sem padrão: a URL do backend, com os mesmos DB_USER, DB_PASSWORD, DB_PORT e DB_NAME acima
DATABASE_URL=postgres://aquarilandia:TROQUE_ESTA_SENHA@localhost:5432/aquarilandia

# --- Endereços públicos (opcionais em desenvolvimento; obrigatórios e com https:// em produção) ---
# Endereço do frontend, usado só para montar links em e-mails
FRONTEND_URL=http://localhost:5173
# Endereço público da API
API_URL=http://localhost:3333

# --- Gateway de pagamento (AbacatePay) — nunca commitar valores reais ---
# Token da API (no Dev mode, o da conta de teste). Vazio: o gateway recusa as chamadas. Obrigatório em produção
GATEWAY_ACCESS_TOKEN=
# Segredo do webhook, combinado com o gateway. Vazio: todo webhook é recusado. Em produção, obrigatório e com
# pelo menos 32 caracteres (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
GATEWAY_WEBHOOK_SECRET=

# --- E-mail (provedor a definir) — nunca commitar valores reais ---
# Chave do provedor. Opcional: vazio em desenvolvimento imprime o e-mail no terminal; em produção sem ela o
# envio é recusado e o log avisa
EMAIL_API_KEY=
# Remetente verificado no provedor
EMAIL_REMETENTE=

# --- Só para scripts e testes: não deixe valores no .env ---
# SENHA_ADMIN: senha do npm run criar-admin; passe na linha de comando, não grave aqui
# TEST_DATABASE_URL: PostgreSQL DESCARTÁVEL do npm run test:integration (testes/README.md); nunca o banco de dev
