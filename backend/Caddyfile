# Caddy de produção (Lote 13): HTTPS automático (Let's Encrypt; com DOMINIO=localhost, um certificado local) e proxy
# para a app, que serve o site e a API no mesmo endereço. O HTTP (80) só redireciona para o HTTPS.
{$DOMINIO} {
	# Sem "Server: Caddy" nas respostas
	header -Server

	reverse_proxy app:3333

	# Log de acesso em JSON no stdout (docker compose logs caddy). O segredo do webhook pode chegar tanto
	# na query string quanto em X-Webhook-Secret. Referer também pode conter o token de recuperação de senha.
	# Estes dados são removidos só do log: continuam sendo encaminhados à app para validar a requisição.
	log {
		output stdout
		format filter {
			request>uri regexp \?.*$ ""
			request>headers>X-Webhook-Secret delete
			request>headers>X-Webhook-Signature delete
			request>headers>Referer delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
		}
	}
}
