# Modelo do backend/.env.producao (produção, docker-compose.prod.yml). Copie (cp .env.producao.example .env.producao)
# NO SERVIDOR e troque cada TROQUE_*. O .env.producao nunca vai para o Git. Segredos: gere no próprio servidor
# (openssl rand -hex 32) e nunca os mande por chat ou e-mail. Roteiro completo: docs/deploy.md.

# --- Ambiente ---
NODE_ENV=production
PORT=3333
# Domínio do site, SEM https:// (o Caddy usa para o certificado). Ex.: loja.exemplo.com.br
DOMINIO=TROQUE_PELO_DOMINIO

# --- Endereços públicos: site e API no MESMO endereço, sempre https:// ---
CORS_ORIGIN=https://TROQUE_PELO_DOMINIO
FRONTEND_URL=https://TROQUE_PELO_DOMINIO
API_URL=https://TROQUE_PELO_DOMINIO

# --- Banco (só na rede interna do Docker; o host do banco é "db") ---
DB_USER=aquarilandia
# openssl rand -hex 32
DB_PASSWORD=TROQUE_POR_UM_SEGREDO_GERADO_NO_SERVIDOR
DB_NAME=aquarilandia
# A mesma senha do DB_PASSWORD acima
DATABASE_URL=postgres://aquarilandia:TROQUE_POR_UM_SEGREDO_GERADO_NO_SERVIDOR@db:5432/aquarilandia

# --- Site servido pela app (a imagem já define; deixe como está) ---
FRONTEND_DIST=/app/frontend-dist
IMAGENS_DIR=/var/lib/aquarilandia/imagens

# --- Gateway de pagamento (AbacatePay) ---
# Vendas reais: chave de PRODUÇÃO da conta recebedora correta (abc_prod_).
# Chave abc_dev_ é exclusiva de teste/demonstração, mesmo com NODE_ENV=production.
GATEWAY_ACCESS_TOKEN=TROQUE_PELA_CHAVE_DA_ABACATEPAY
# openssl rand -hex 32 (pelo menos 32 caracteres); o mesmo segredo cadastrado no webhook da AbacatePay
GATEWAY_WEBHOOK_SECRET=TROQUE_POR_UM_SEGREDO_GERADO_NO_SERVIDOR

# --- E-mail (Resend, D-54): OBRIGATÓRIAS em produção (sem elas o servidor não sobe) ---
# Chave da API do Resend (painel do Resend → API Keys; começa com re_)
EMAIL_API_KEY=TROQUE_PELA_CHAVE_DO_RESEND
# Um endereço do domínio verificado no Resend (docs/deploy.md, passo do Resend). Ex.: Aquarilândia <nao-responda@SEU_DOMINIO>
EMAIL_REMETENTE=Aquarilândia <nao-responda@TROQUE_PELO_DOMINIO>

# --- Demonstração ---
# true só na demonstração com a chave de TESTE: liga POST /api/pagamentos/:id/simular (admin). Com a chave de produção
# a rota não existe, mesmo com true
PERMITIR_SIMULACAO_PIX=false

# Legado de desenvolvimento; não habilita entregas em produção.
FRETE_TABELA_JSON=
# Sem tabela comercial aprovada, deixe vazio: entregas bloqueadas e retirada disponível.
# Formato em docs/entrega-logistica-2026-11-17.md. Nunca use tarifas fictícias de testes.
FRETE_TRANSPORTE_JSON=
