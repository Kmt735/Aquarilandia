# Copie para .env.local (que não vai para o Git) e ajuste na sua máquina.
# Na Vercel, as mesmas chaves vão em Settings → Environment Variables (são lidas no build: mudou, faça redeploy).
# Nenhuma delas é segredo: tudo que começa com VITE_ vai parar no JavaScript público do site.

# Endereço da API. Padrão /api: em desenvolvimento o Vite encaminha para o backend (vite.config.js) e na Vercel o
# vercel.json encaminha para o Render, no mesmo endereço do site (o cookie de sessão depende disso).
# Só troque por um endereço absoluto se souber o que faz: o login para de funcionar em navegadores que bloqueiam
# cookies de outro site (Safari, por exemplo)
VITE_API_URL=/api

# true  = usa os DADOS DE DEMONSTRAÇÃO de src/mocks/catalogo-api.js no lugar da API do catálogo
#         (útil enquanto o banco não tem produtos; aparece o selo "Dados de demonstração").
# false = usa a API real (/api/produtos, /api/peixes). Padrão.
VITE_CATALOGO_MOCK=false

# Botão de simulação administrativa; somente em demonstração com a API também autorizada e chave de teste.
VITE_SIMULACAO_PIX=false
