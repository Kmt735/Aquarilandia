# Copie para .env.local (que não vai para o Git) e ajuste na sua máquina.

# true  = usa os DADOS DE DEMONSTRAÇÃO de src/mocks/catalogo-api.js no lugar da API do catálogo
#         (útil enquanto o banco não tem produtos; aparece o selo "Dados de demonstração").
# false = usa a API real (/api/produtos, /api/peixes). Padrão.
VITE_CATALOGO_MOCK=false
